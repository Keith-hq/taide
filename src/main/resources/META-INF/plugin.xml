<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
    <id>edu.cst3492.taide</id>
    <name>TAIDE</name>
    <version>0.1.0-SNAPSHOT</version>
    <vendor>TAIDE · CST3492 Group B</vendor>
    <description><![CDATA[
        A course teaching assistant inside IntelliJ IDEA. Ask about selected code,
        read streaming answers and inspect their course material citations.
    ]]></description>
    <idea-version since-build="242"/>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="TAIDE"
                    anchor="right"
                    icon="/icons/taide.svg"
                    factoryClass="edu.cst3492.taide.ui.TaideToolWindowFactory"/>
        <projectConfigurable id="edu.cst3492.taide.settings"
                             parentId="tools"
                             displayName="TAIDE"
                             instance="edu.cst3492.taide.ui.settings.TaideSettingsConfigurable"/>
        <projectService serviceImplementation="edu.cst3492.taide.ui.settings.TaideUiSettings"/>
        <projectService serviceInterface="edu.cst3492.taide.service.TaideService"
                        serviceImplementation="edu.cst3492.taide.service.TaideServiceImpl"/>
        <projectService serviceInterface="edu.cst3492.taide.ui.integration.KnowledgeBaseController"
                        serviceImplementation="edu.cst3492.taide.ui.integration.ProjectKnowledgeBaseController"/>
        <notificationGroup id="TAIDE" displayType="BALLOON" isLogByDefault="true"/>
    </extensions>

    <actions>
        <action id="taide.askAboutCode"
                class="edu.cst3492.taide.action.AskTaideAction"
                text="Ask TAIDE about This Code"
                description="Explain the selected code with course material references"
                icon="/icons/taide.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

    </actions>
    <xi:include href="/META-INF/taide-automation.xml" xpointer="xpointer(/idea-plugin/*)"/>
</idea-plugin>
